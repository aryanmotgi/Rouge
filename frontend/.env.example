# The dashboard defaults to the REAL pipeline over WebSocket (see src/feed/config.ts):
#   VITE_FEED_TRANSPORT=websocket
#   VITE_EVENTS_URL=ws://localhost:8787/stream
#
# Override in .env.local only if the pipeline runs on a different machine, e.g.:
# VITE_FEED_TRANSPORT=websocket
# VITE_EVENTS_URL=ws://10.104.182.48:8787/stream
#
# Or set transport=mock for offline UI work against canned scenarios:
# VITE_FEED_TRANSPORT=mock

# Copy to .env (gitignored) and fill in. Rouge backend config.

# ── LLM provider ────────────────────────────────────────────────────────────
# anthropic = Claude Haiku 4.5 (paid, no rate-limit risk — recommended for demo)
# groq      = free tier, kept as a fallback (rate-limited)
# gemini    = Google Gemini (free tier is 20 req/day — unusable)
LLM_PROVIDER=anthropic

# ── Anthropic (set these when LLM_PROVIDER=anthropic) ───────────────────────
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=            # create at https://console.anthropic.com (needs a small prepaid credit)

# ── Groq fallback (set LLM_PROVIDER=groq to use) ────────────────────────────
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=gsk_...         # from https://console.groq.com

# ── Gemini fallback ─────────────────────────────────────────────────────────
# GEMINI_API_KEY=

# pacing between LLM calls (seconds) — only matters for rate-limited free tiers;
# with anthropic you can lower this to 0 for a snappier demo
LLM_MIN_INTERVAL=1.0

# ── Sponsor infra ───────────────────────────────────────────────────────────
WASMER_TOKEN=
TENKI_AUTH_TOKEN=

# ── Trap / decoy ────────────────────────────────────────────────────────────
TRAP_BACKEND=mock            # tenki (real microVM) | mock (instant, venue-safe)
DECOY_PRIMARY_URL=           # Shreyash's real Wasmer decoy, e.g. http://<his-ip>:8791/accounts
DECOY_STUB_URL=http://127.0.0.1:8790/accounts

# ── Pipeline ────────────────────────────────────────────────────────────────
ROUGE_PIPELINE_URL=http://127.0.0.1:8787
